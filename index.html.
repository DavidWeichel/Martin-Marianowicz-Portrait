<style>
  :root{
    --paper:#FBF8F2;--paper-2:#F3ECDF;--ink:#1B1813;--ink-soft:#5B5247;
    --wine:#6E1320;--gold:#B0843D;--line:rgba(27,24,19,.12);
    --serif:'Fraunces',Georgia,serif;--sans:'Mulish',-apple-system,sans-serif;
    --gut:clamp(40px,6vw,112px);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-weight:400;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  ::selection{background:var(--wine);color:var(--paper)}
  img{display:block;max-width:100%}
  .wrap{max-width:1200px;margin:0 auto;padding:0 var(--gut)}

  nav{position:fixed;inset:0 0 auto 0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:24px var(--gut);transition:all .4s}
  nav.scrolled{background:rgba(251,248,242,.92);backdrop-filter:blur(12px);padding:14px var(--gut);box-shadow:0 1px 0 var(--line)}
  .brand{font-family:var(--serif);font-size:1.05rem;font-weight:400;letter-spacing:.02em;text-decoration:none;color:var(--ink)}
  .nav-links{display:flex;gap:24px;align-items:center}
  .nav-links a{color:var(--ink-soft);text-decoration:none;font-size:.78rem;font-weight:600;letter-spacing:.03em;transition:color .3s}
  .nav-links a:hover{color:var(--wine)}
  .nav-kontakt{border:1px solid var(--ink);border-radius:40px;padding:8px 16px;color:var(--ink)!important}
  .nav-kontakt:hover{background:var(--ink);color:var(--paper)!important}
  .burger{display:none;font-size:1.4rem;cursor:pointer;background:none;border:none;color:var(--ink)}
  @media(max-width:1040px){.nav-links{display:none}.burger{display:block}}

  header{padding:190px 0 84px;text-align:center}
  .hero-quote{font-family:var(--serif);font-weight:300;font-size:clamp(2rem,4.6vw,3.6rem);line-height:1.16;letter-spacing:-.015em;max-width:24ch;margin:0 auto 30px}
  .hero-quote .q{color:var(--gold)}
  .hero-sub{font-size:1.1rem;color:var(--ink-soft);max-width:60ch;margin:0 auto 24px;font-weight:300}
  .hero-name{font-size:.78rem;letter-spacing:.26em;text-transform:uppercase;color:var(--wine);font-weight:700;margin-bottom:34px}
  .hero-img{margin-top:56px}
  .hero-img img{width:100%;height:min(70vh,680px);object-fit:cover;object-position:center 16%;border-radius:4px}

  .btn{display:inline-block;background:var(--wine);color:var(--paper);text-decoration:none;padding:15px 32px;border-radius:40px;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;font-weight:600;transition:all .4s;cursor:pointer;border:none}
  .btn:hover{background:var(--ink);transform:translateY(-2px)}
  .btn-line{display:inline-flex;align-items:center;gap:8px;color:var(--wine);text-decoration:none;font-weight:600;font-size:.9rem;border-bottom:1px solid transparent;transition:all .3s}
  .btn-line:hover{gap:14px;border-color:var(--gold);color:var(--gold)}

  .credo{border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .credo-inner{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:12px 32px;padding:26px var(--gut);max-width:1100px;margin:0 auto}
  .credo-inner span{font-size:.74rem;letter-spacing:.15em;text-transform:uppercase;color:var(--ink-soft);font-weight:600}
  .credo-inner i{width:4px;height:4px;border-radius:50%;background:var(--gold)}

  .eyebrow{font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:20px;display:flex;align-items:center;gap:12px}
  .eyebrow b{color:var(--wine)}
  h2{font-family:var(--serif);font-weight:300;font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.16;letter-spacing:-.015em;margin-bottom:22px}
  .lead p{color:var(--ink-soft);margin-bottom:16px;font-weight:300;font-size:1.02rem}

  .row{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;max-width:1200px;margin:0 auto;padding:104px var(--gut);border-bottom:1px solid var(--line)}
  .row.flip .row-text{order:2}
  .row-text p{color:var(--ink-soft);margin-bottom:16px;font-weight:300;font-size:1.02rem}
  .row-img img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:top center;border-radius:4px}
  .row-img.wide img{aspect-ratio:5/4}
  .row .actions{margin-top:14px;display:flex;flex-wrap:wrap;gap:18px 26px;align-items:center}
  @media(max-width:880px){.row{grid-template-columns:1fr;gap:38px;padding:72px var(--gut)}.row.flip .row-text{order:0}}

  .band{position:relative;padding:130px 0;background:var(--ink);overflow:hidden}
  .band img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 20%;filter:grayscale(1) contrast(1.04);opacity:.4}
  .band::after{content:"";position:absolute;inset:0;background:linear-gradient(95deg,rgba(27,24,19,.86),rgba(27,24,19,.42))}
  .band .wrap{position:relative;z-index:2}
  .band blockquote{font-family:var(--serif);font-weight:300;font-style:italic;font-size:clamp(1.7rem,3.6vw,2.8rem);line-height:1.26;color:var(--paper);max-width:22ch}
  .band cite{display:block;margin-top:26px;font-style:normal;font-size:.76rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}

  .block{padding:108px 0;border-bottom:1px solid var(--line)}
  .block .head{max-width:720px;margin:0 auto 56px;text-align:center}
  .block .head.left{margin-left:0;text-align:left}
  .block .head .eyebrow{justify-content:center}
  .block .head.left .eyebrow{justify-content:flex-start}

  /* steps */
  .steps{max-width:860px;margin:0 auto;counter-reset:s}
  .step{display:grid;grid-template-columns:64px 1fr;gap:28px;padding:30px 0;border-top:1px solid var(--line)}
  .step:last-child{border-bottom:1px solid var(--line)}
  .step .no{font-family:var(--serif);font-size:1.6rem;color:var(--gold)}
  .step h3{font-family:var(--serif);font-weight:400;font-size:1.3rem;margin-bottom:8px}
  .step p{color:var(--ink-soft);font-weight:300;font-size:.98rem}
  .step a{color:var(--wine);text-decoration:none;border-bottom:1px solid var(--gold)}
  .center-cta{text-align:center;margin-top:54px}

  /* faq */
  .faq{max-width:820px;margin:0 auto}
  details{border-top:1px solid var(--line);padding:4px 0}
  details:last-of-type{border-bottom:1px solid var(--line)}
  summary{list-style:none;cursor:pointer;padding:24px 0;font-family:var(--serif);font-size:1.18rem;font-weight:400;display:flex;justify-content:space-between;align-items:center;gap:20px}
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";color:var(--gold);font-size:1.5rem;font-weight:300;transition:transform .3s}
  details[open] summary::after{transform:rotate(45deg)}
  .faq-body{padding:0 0 26px;color:var(--ink-soft);font-weight:300}
  .faq-body ul{margin:10px 0 0 18px}.faq-body li{margin-bottom:6px}

  /* pillars */
  .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:1100px;margin:0 auto}
  .pillar{border:1px solid var(--line);border-radius:6px;padding:40px 32px;transition:all .4s;background:var(--paper)}
  .pillar:hover{border-color:var(--gold);transform:translateY(-4px)}
  .pillar .pn{font-family:var(--serif);color:var(--gold);font-size:1rem;margin-bottom:18px}
  .pillar h3{font-family:var(--serif);font-weight:400;font-size:1.4rem;margin-bottom:12px}
  .pillar p{color:var(--ink-soft);font-weight:300;font-size:.96rem;margin-bottom:22px}
  @media(max-width:880px){.pillars{grid-template-columns:1fr}}

  /* consulting blocks */
  .consult{display:grid;grid-template-columns:1fr 1fr;gap:64px;max-width:1100px;margin:0 auto}
  .consult .tag{font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:14px}
  .consult h3{font-family:var(--serif);font-weight:400;font-size:1.5rem;margin-bottom:16px}
  .consult p{color:var(--ink-soft);font-weight:300;font-size:.98rem;margin-bottom:20px}
  .checklist{list-style:none;margin-top:8px}
  .checklist li{position:relative;padding:10px 0 10px 30px;border-top:1px solid var(--line);color:var(--ink-soft);font-size:.95rem;font-weight:300}
  .checklist li::before{content:"";position:absolute;left:0;top:17px;width:13px;height:8px;border-left:2px solid var(--gold);border-bottom:2px solid var(--gold);transform:rotate(-45deg)}
  @media(max-width:880px){.consult{grid-template-columns:1fr;gap:48px}}

  /* books */
  .books{display:grid;grid-template-columns:repeat(3,1fr);gap:46px;max-width:1080px;margin:0 auto}
  .book .cv{aspect-ratio:3/4.2;border-radius:3px;box-shadow:0 22px 48px -24px rgba(0,0,0,.5);overflow:hidden;transition:transform .4s}
  .book:hover .cv{transform:translateY(-6px)}
  .book .cv img{width:100%;height:100%;object-fit:cover}
  .book .cv.txt{display:flex;flex-direction:column;justify-content:space-between;padding:30px 26px}
  .book .cv.txt .t{font-family:var(--serif);font-weight:400;font-size:1.5rem;line-height:1.15}
  .book .cv.txt .s{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;opacity:.8}
  .cv-wine{background:linear-gradient(155deg,#6E1320,#3d0a12);color:var(--paper)}
  .cv-gold{background:linear-gradient(155deg,#B0843D,#7d5d28);color:#fff}
  .book h4{font-family:var(--serif);font-weight:400;font-size:1.15rem;margin:22px 0 4px}
  .book .ttl-sub{font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:10px}
  .book p{color:var(--ink-soft);font-size:.9rem;font-weight:300}
  @media(max-width:880px){.books{grid-template-columns:1fr;gap:50px;max-width:330px}}

  /* videos */
  .videos{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;max-width:1100px;margin:0 auto}
  .video{text-decoration:none;color:inherit;display:block}
  .video .thumb{position:relative;aspect-ratio:16/10;border-radius:5px;background:linear-gradient(150deg,#2a2520,#100d0b);overflow:hidden;display:flex;align-items:center;justify-content:center;border:1px solid var(--line)}
  .video .play{width:56px;height:56px;border-radius:50%;background:rgba(251,248,242,.12);border:1px solid rgba(251,248,242,.4);display:flex;align-items:center;justify-content:center;transition:all .4s}
  .video:hover .play{background:var(--wine);border-color:var(--wine)}
  .video .play::after{content:"";border-left:15px solid var(--paper);border-top:9px solid transparent;border-bottom:9px solid transparent;margin-left:4px}
  .video p{margin-top:16px;color:var(--ink-soft);font-weight:300;font-size:.94rem}
  .video .src{font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-top:8px}
  @media(max-width:880px){.videos{grid-template-columns:1fr;max-width:420px}}

  /* kontakt */
  .kontakt{padding:108px 0}
  .kontakt-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:80px}
  .kontakt h2{margin-bottom:18px}
  .kontakt .lead p{margin-bottom:26px;max-width:46ch}
  .field{margin-bottom:18px}
  .field label{display:block;font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:7px}
  .field input,.field textarea{width:100%;background:var(--paper);border:1px solid var(--line);border-radius:5px;padding:13px 15px;font-family:var(--sans);font-size:.98rem;color:var(--ink)}
  .field input:focus,.field textarea:focus{outline:none;border-color:var(--gold)}
  .consent{display:flex;gap:10px;align-items:flex-start;font-size:.82rem;color:var(--ink-soft);font-weight:300;margin:8px 0 22px}
  .info div{display:flex;gap:18px;padding:18px 0;border-bottom:1px solid var(--line)}
  .info .k{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:700;min-width:84px;padding-top:4px}
  .info .v{font-size:1rem}
  .info .v small{display:block;color:var(--ink-soft);font-size:.88rem}
  @media(max-width:880px){.kontakt-grid{grid-template-columns:1fr;gap:48px}}

  footer{background:var(--ink);color:var(--paper);padding:60px 0 34px}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:36px;border-bottom:1px solid rgba(251,248,242,.16)}
  .foot-brand{font-family:var(--serif);font-size:1.4rem;font-weight:300;margin-bottom:14px}
  .foot-grid p,.foot-grid a{color:rgba(251,248,242,.66);font-size:.9rem;text-decoration:none;font-weight:300;line-height:1.9}
  .foot-grid a:hover{color:var(--gold)}
  .foot-grid h5{font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:12px}
  .foot-col a{display:block}
  .foot-bottom{padding-top:26px;font-size:.78rem;color:rgba(251,248,242,.5)}
  @media(max-width:880px){.foot-grid{grid-template-columns:1fr;gap:30px}}

  .reveal{opacity:0;transform:translateY(28px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1)}
  .reveal.in{opacity:1;transform:none}
</style>
